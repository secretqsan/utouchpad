<Page
    x:Class="Utochpad.Panel.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Stretch"
            Spacing="16"
            Padding="28,20">
            <TextBlock
                Text="关于"
                Style="{StaticResource TitleTextBlockStyle}"
                FontSize="26"
                FontWeight="SemiBold" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/Utochpad.png" />
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Utochpad" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock
                                Text="让 Android 手机充当 Windows 的指纹解锁、精密触控板与 Radial 控制器。"
                                FontSize="13"
                                Opacity="0.72"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Height="1"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="控制面板" Opacity="0.72" />
                        <TextBlock x:Name="PanelVersionText" Grid.Column="1" FontWeight="SemiBold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="后台服务" Opacity="0.72" />
                        <TextBlock x:Name="ServiceVersionText" Grid.Column="1" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                Text="触控板和 Radial 通过 VIIPER 以虚拟 USB 设备实现。"
                FontSize="12"
                Opacity="0.62"
                TextWrapping="Wrap"
                Margin="4,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
