<Page
    x:Class="Utochpad.Panel.Pages.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Utochpad.Panel.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Stretch"
            Spacing="16"
            Padding="28,20">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Text="维护"
                    Style="{StaticResource TitleTextBlockStyle}"
                    FontSize="26"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="18"
                    VerticalAlignment="Center">
                    <controls:StatusIndicator x:Name="ServiceStatus" Text="检查中" />
                    <controls:StatusIndicator x:Name="ComponentStatus" Text="检查中" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="诊断信息" FontSize="17" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="DiagnosticInfo"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        MinHeight="130"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新" Click="OnRefreshClick" />
                        <Button x:Name="RestartButton" Content="重启输入组件" Click="OnRestartClick" />
                        <Button
                            x:Name="UnpairButton"
                            Content="解除配对"
                            Click="OnUnpairClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
