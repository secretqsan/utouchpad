<Page
    x:Class="Utochpad.Panel.Pages.PasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Utochpad.Panel.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Stretch"
            Spacing="16"
            Padding="28,20">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Text="Windows 密码"
                    Style="{StaticResource TitleTextBlockStyle}"
                    FontSize="26"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <controls:StatusIndicator
                    x:Name="PasswordStatus"
                    Grid.Column="1"
                    Text="—"
                    VerticalAlignment="Center" />
            </Grid>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <PasswordBox
                            x:Name="PasswordInput"
                            PlaceholderText="Windows 账户密码"
                            PasswordRevealMode="Peek"
                            PasswordChanged="OnPasswordChanged"
                            KeyDown="OnPasswordKeyDown" />
                        <Button
                            x:Name="SendButton"
                            Grid.Column="1"
                            Content="发送到手机"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSendClick" />
                    </Grid>
                    <TextBlock
                        x:Name="HelpText"
                        Text="请填写 Windows 账户密码，不是 PIN 码。"
                        FontSize="12"
                        Opacity="0.72"
                        TextWrapping="Wrap" />
                    <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
