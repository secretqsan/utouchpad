{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Utochpad",
  "mainBinaryName": "Utochpad",
  "version": "1.0.0",
  "identifier": "com.liuxi.utochpad",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../../../.build/panel-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Utochpad",
        "width": 920,
        "height": 620,
        "minWidth": 880,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#e9eaec",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
