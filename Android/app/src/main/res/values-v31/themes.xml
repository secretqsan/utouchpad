<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ always draws a splash window; keep it invisible so the app
         appears to open directly on its first page. -->
    <style name="Theme.Utochpad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/window_background</item>
    </style>
</resources>
