<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand app mark, traced from brand/utochpad-logo.svg: one wide touchpad,
  raised from the warm sheet, with the four-point star and guide line engraved
  into its surface.

  A launcher icon is read at roughly 48dp, so the star and guide line are scaled
  up from the brand drawing and the surface is kept flat. Vector drawables
  cannot blur a shadow, and stacked translucent copies read as hard rings at
  small sizes, so the mark carries no cast shadow here.

  The mark sits on the white tile from ic_launcher_background.xml; the face is
  slightly deeper than the brand drawing so its upper-left edge stays visible
  against white. The star is oversized on purpose: its top tip clears the pad
  edge and rests on the white tile.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pad face, lit from the upper left. -->
    <path android:pathData="M31.5,38 H76.5 A6.5,6.5 0 0 1 83,44.5 V63.5 A6.5,6.5 0 0 1 76.5,70 H31.5 A6.5,6.5 0 0 1 25,63.5 V44.5 A6.5,6.5 0 0 1 31.5,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="83"
                android:endY="70"
                android:startX="25"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#FFFCF5E9"
                    android:offset="0" />
                <item
                    android:color="#FFF5E9D6"
                    android:offset="0.55" />
                <item
                    android:color="#FFE6D1B2"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rim light along the upper-left edge. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31.5,38.8 H76.5 A5.7,5.7 0 0 1 82.2,44.5 V63.5 A5.7,5.7 0 0 1 76.5,69.2 H31.5 A5.7,5.7 0 0 1 25.8,63.5 V44.5 A5.7,5.7 0 0 1 31.5,38.8 Z"
        android:strokeWidth="1.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="62"
                android:endY="66"
                android:startX="26"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#F2FFFEF9"
                    android:offset="0" />
                <item
                    android:color="#38FFFDF7"
                    android:offset="0.6" />
                <item
                    android:color="#00FFFDF7"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Four-point star, enlarged so its top tip clears the pad edge. -->
    <path
        android:fillColor="#FFB58A57"
        android:pathData="M69.5,35 C69.5,42.03 70.97,44 78.5,44 C70.97,44 69.5,45.97 69.5,53 C69.5,45.97 68.03,44 60.5,44 C68.03,44 69.5,42.03 69.5,35 Z" />

    <!-- Guide line engraved at the bottom centre. -->
    <path
        android:fillColor="#FFB58A57"
        android:pathData="M54,57.5 A0.8,0.8 0 0 1 54.8,58.3 V66.7 A0.8,0.8 0 0 1 54,67.5 A0.8,0.8 0 0 1 53.2,66.7 V58.3 A0.8,0.8 0 0 1 54,57.5 Z" />
</vector>
